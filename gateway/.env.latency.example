# Latency-related gateway/.env knobs (MT tuned values).
# Copy the lines you want into gateway/.env — do NOT commit real .env.
# 说明：这些旋钮只调本地唤醒确认 / 设备侧起播缓冲，不是云端首包延迟。
# Dominant TTFA (~3s) is cloud Grok voice RTT, not these knobs.

# Guard before the first TTS/Opus frame is sent after tts.start (seconds).
# Firmware applies tts.start on its main task; a tiny delay avoids racing the
# first binary frame while the device is still Listening.
# Default in code: 0.08. Tuned: 0.04.
STACKCHAN_GEMINI_TTS_START_DELAY_SECONDS=0.04

# Hold the first PCM burst until this many ms are buffered, then release.
# Softens Gemini/Grok downlink jitter before the speaker underruns.
# Default in code: 200. Tuned: 80. Set 0 to disable.
STACKCHAN_GEMINI_PREBUFFER_MS=80

# After wake confirm emotion, hold this many seconds before switching to
# listening emotion / chime (wake UX only; does not shrink cloud TTFA).
# Default in code: 0.3. Tuned: 0.15.
STACKCHAN_WAKE_CONFIRM_HOLD_S=0.15

# Periodic uplink RMS logging for gain debugging (1/true on, 0/false off).
# Keep off in normal use; noisy and not a latency lever.
# Default: 0.
STACKCHAN_GBOT_UPLINK_RMS_LOG=0
